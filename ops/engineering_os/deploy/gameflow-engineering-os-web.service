[Unit]
Description=GameFlow Engineering OS private web dashboard
After=network-online.target

[Service]
Type=simple
ExecStart=/home/chase/.local/share/gameflow-engineering-os/venv/bin/gfos --config /home/chase/.config/gameflow-engineering-os/engineering_os.yaml serve
Restart=on-failure
RestartSec=5
WorkingDirectory=/home/chase/projects/GameFlowData/ops/engineering_os
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
