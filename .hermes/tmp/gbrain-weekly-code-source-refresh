#!/usr/bin/env bash
set -Eeuo pipefail

export PATH="$HOME/.bun/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export GBRAIN_SOURCE=gameflow

LOG_DIR="$HOME/.gbrain/logs"
RUN_DIR="$HOME/.gbrain/run"
mkdir -p "$LOG_DIR" "$RUN_DIR"
LOG_FILE="$LOG_DIR/weekly-code-source-refresh-$(date -u +%Y%m%dT%H%M%SZ).log"
LOCK_FILE="$RUN_DIR/weekly-code-source-refresh.lock"
NIGHTLY_LOCK_FILE="$RUN_DIR/nightly-sync-audit.lock"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Another weekly code-source refresh is running; exiting."
  exit 0
fi

if [[ -e "$NIGHTLY_LOCK_FILE" ]]; then
  exec 8>"$NIGHTLY_LOCK_FILE"
  if ! flock -n 8; then
    echo "Nightly gbrain sync/audit is running; weekly code-source refresh exiting."
    exit 0
  fi
fi

exec > >(tee -a "$LOG_FILE") 2>&1

section() { printf '\n== %s ==\n' "$*"; }
run() { printf '+ '; printf '%q ' "$@"; printf '\n'; "$@"; }
failures=()

CODE_SOURCES=(
  gameflow-code-mlb-pilot
  gameflow-code-modeling-core
  gameflow-code-mlb-backtests
)

section "start"
date -u +%Y-%m-%dT%H:%M:%SZ
hostname
printf 'log: %s\n' "$LOG_FILE"

if [[ -f "$HOME/.hermes/.env" ]]; then
  set -a; . "$HOME/.hermes/.env"; set +a
fi
if [[ -f "$HOME/.gbrain/gameflow-db.env" ]]; then
  set -a; . "$HOME/.gbrain/gameflow-db.env"; set +a
fi
: "${GBRAIN_DATABASE_URL:?GBRAIN_DATABASE_URL missing; expected ~/.gbrain/gameflow-db.env}"

section "refresh code mirrors"
python3 - <<'PY'
from pathlib import Path
import subprocess
import sys

repo = Path.home() / "projects/GameFlowData"
mirrors = {
    "gameflow-code-mlb-pilot": Path.home() / "GameFlowCodePilot",
    "gameflow-code-modeling-core": Path.home() / "GameFlowCodeModelingCore",
    "gameflow-code-mlb-backtests": Path.home() / "GameFlowCodeMLBModelingBacktesting",
}
if not repo.exists():
    print(f"FAIL remote GameFlowData checkout missing: {repo}")
    sys.exit(20)

for source_id, mirror in mirrors.items():
    if not mirror.exists():
        print(f"FAIL mirror missing for {source_id}: {mirror}")
        sys.exit(21)
    files = [p for p in mirror.rglob("*") if p.is_file() and ".git" not in p.parts and p.name != ".gbrain-source"]
    updated = 0
    missing = 0
    for dst in files:
        rel = dst.relative_to(mirror)
        src = repo / rel
        if not src.exists():
            print(f"WARN {source_id}: source missing for mirror file {rel}")
            missing += 1
            continue
        before = dst.read_bytes()
        after = src.read_bytes()
        if before != after:
            dst.write_bytes(after)
            updated += 1
    if (mirror / ".git").exists():
        subprocess.run(["git", "add", "."], cwd=mirror, check=True, stdout=subprocess.DEVNULL)
        diff = subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=mirror)
        if diff.returncode != 0:
            subprocess.run(["git", "commit", "-m", "Weekly refresh from GameFlowData checkout"], cwd=mirror, check=True, stdout=subprocess.DEVNULL)
            print(f"UPDATED {source_id}: {updated} file(s), committed in {mirror}")
        else:
            print(f"OK {source_id}: no changes in {mirror}")
    else:
        print(f"UPDATED {source_id}: {updated} file(s), no git repo at {mirror}")
    if missing:
        print(f"WARN {source_id}: {missing} mirror file(s) had no source counterpart")
PY

section "sync code sources"
cd "$HOME/gbrain"
for source_id in "${CODE_SOURCES[@]}"; do
  echo "-- source: $source_id"
  if ! gbrain reindex-code --source "$source_id" --yes --force; then
    echo "WARN: reindex-code --force failed for $source_id; retrying without --force"
    if ! gbrain reindex-code --source "$source_id" --yes; then
      failures+=("source code reindex failed: $source_id")
    fi
  fi
done

section "embed stale"
if ! run gbrain embed --stale; then
  failures+=("gbrain embed --stale failed")
fi

section "final orphans"
ORPHANS_FILE="$LOG_FILE.orphans.json"
if gbrain orphans --json > "$ORPHANS_FILE"; then
  cat "$ORPHANS_FILE"
  ORPHAN_COUNT="$(python3 - "$ORPHANS_FILE" <<'PY'
import json, sys
s=open(sys.argv[1], encoding="utf-8").read(); i=s.find("{")
print(json.loads(s[i:]).get("total_orphans", 0))
PY
)"
  if [[ "$ORPHAN_COUNT" != "0" ]]; then
    failures+=("orphan pages: $ORPHAN_COUNT")
  fi
else
  failures+=("gbrain orphans --json failed")
  ORPHAN_COUNT="unknown"
fi

section "doctor freshness gate"
DOCTOR_FILE="$LOG_FILE.doctor.json"
if gbrain doctor --json > "$DOCTOR_FILE"; then
  set +e
  python3 - "$DOCTOR_FILE" "${CODE_SOURCES[@]}" <<'PY'
import json
import sys
from pathlib import Path
path = Path(sys.argv[1])
targets = set(sys.argv[2:])
s = path.read_text(encoding="utf-8")
i = s.find("{")
if i < 0:
    print("FAIL doctor JSON object not found")
    sys.exit(30)
d = json.loads(s[i:])
print(json.dumps({"status": d.get("status"), "health_score": d.get("health_score")}, indent=2))
stale_targets = []
for c in d.get("checks", []):
    status = c.get("status")
    name = c.get("name")
    message = c.get("message") or ""
    if status in {"fail", "warn"}:
        print(f"{status.upper()}: {name}: {message}")
    if name == "sync_freshness" and status in {"fail", "warn"}:
        stale_targets = sorted(t for t in targets if t in message)
if stale_targets:
    print("TARGET_STALE " + " ".join(stale_targets))
    sys.exit(31)
PY
  rc=$?
  set -e
  if [[ "$rc" == "31" ]]; then
    failures+=("target code sources still stale after sync")
  elif [[ "$rc" != "0" ]]; then
    failures+=("doctor freshness parsing failed")
  fi
else
  failures+=("gbrain doctor --json failed")
fi

section "summary"
MISSING_EMBEDS="unknown"
if MISSING_EMBEDS="$(psql "$GBRAIN_DATABASE_URL" -Atc "select count(*) from content_chunks where embedding is null;")"; then
  echo "missing_embeddings: $MISSING_EMBEDS"
  if [[ "$MISSING_EMBEDS" != "0" ]]; then
    failures+=("missing embeddings: $MISSING_EMBEDS")
  fi
else
  failures+=("missing embedding count query failed")
fi

echo "orphans: ${ORPHAN_COUNT:-unknown}"
echo "log: $LOG_FILE"
if ((${#failures[@]})); then
  printf 'FAIL: %s\n' "${failures[@]}"
  exit 1
fi
echo "PASS: weekly GameFlow GBrain code-source refresh completed"
