#!/usr/bin/env bash
set -Eeuo pipefail

export PATH="$HOME/.bun/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export GBRAIN_SOURCE=gameflow

LOG_DIR="$HOME/.gbrain/logs"
mkdir -p "$LOG_DIR" "$HOME/.gbrain/run"
LOG_FILE="$LOG_DIR/nightly-sync-audit-$(date -u +%Y%m%dT%H%M%SZ).log"
LOCK_FILE="$HOME/.gbrain/run/nightly-sync-audit.lock"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  echo "Another gbrain nightly sync/audit is already running; exiting."
  exit 0
fi

exec > >(tee -a "$LOG_FILE") 2>&1

section() { printf '\n== %s ==\n' "$*"; }
run() { printf '+ %q ' "$@"; printf '\n'; "$@"; }

section "start"
date -u +%Y-%m-%dT%H:%M:%SZ
hostname

if [[ -f "$HOME/.hermes/.env" ]]; then
  set -a; . "$HOME/.hermes/.env"; set +a
fi
if [[ -f "$HOME/.gbrain/gameflow-db.env" ]]; then
  set -a; . "$HOME/.gbrain/gameflow-db.env"; set +a
fi
: "${GBRAIN_DATABASE_URL:?GBRAIN_DATABASE_URL missing; expected ~/.gbrain/gameflow-db.env}"

section "source freshness"
# Keep this deterministic and low-risk: do not auto-pull GameFlowData or GameFlowBrain by default.
# Sync reflects the current checked-out files on the remote. Set GBRAIN_NIGHTLY_PULL_BRAIN=1 only if
# you explicitly want this job to git pull ~/GameFlowBrain when it is clean and has an upstream.
if [[ "${GBRAIN_NIGHTLY_PULL_BRAIN:-0}" == "1" ]]; then
  if git -C "$HOME/GameFlowBrain" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    if [[ -z "$(git -C "$HOME/GameFlowBrain" status --porcelain)" ]] && git -C "$HOME/GameFlowBrain" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
      run git -C "$HOME/GameFlowBrain" pull --ff-only
    else
      echo "Skipping GameFlowBrain pull: dirty tree or no upstream."
    fi
  fi
else
  echo "Git auto-pull disabled; syncing current remote checkout."
fi

section "refresh code mirrors"
python3 - <<'PY'
from pathlib import Path
import shutil, subprocess
repo = Path.home() / "projects/GameFlowData"
mirrors = [
    Path.home() / "GameFlowCodePilot",
    Path.home() / "GameFlowCodeModelingCore",
    Path.home() / "GameFlowCodeMLBModelingBacktesting",
]
for mirror in mirrors:
    if not mirror.exists():
        print(f"SKIP missing mirror {mirror}")
        continue
    files = [p for p in mirror.rglob("*") if p.is_file() and ".git" not in p.parts and p.name != ".gbrain-source"]
    updated = 0
    for dst in files:
        rel = dst.relative_to(mirror)
        src = repo / rel
        if not src.exists():
            print(f"WARN source missing for mirror file: {rel}")
            continue
        before = dst.read_bytes()
        after = src.read_bytes()
        if before != after:
            dst.write_bytes(after)
            updated += 1
    if (mirror / ".git").exists():
        subprocess.run(["git", "add", "."], cwd=mirror, check=True, stdout=subprocess.DEVNULL)
        diff = subprocess.run(["git", "diff", "--cached", "--quiet"], cwd=mirror)
        if diff.returncode != 0:
            subprocess.run(["git", "commit", "-m", "Nightly refresh from GameFlowData checkout"], cwd=mirror, check=True, stdout=subprocess.DEVNULL)
            print(f"UPDATED {mirror.name}: {updated} file(s), committed")
        else:
            print(f"OK {mirror.name}: no changes")
    else:
        print(f"UPDATED {mirror.name}: {updated} file(s), no git repo")
PY

section "gbrain service health before sync"
curl -fsS http://127.0.0.1:3131/health || true

section "sync all sources"
cd "$HOME/gbrain"
run gbrain sync --all --no-pull --yes --retry-failed

section "embed stale"
run gbrain embed --stale

section "markdown graph/timeline backfill"
cd "$HOME/GameFlowBrain"
run bun scripts/backfill_gameflow_graph.ts

section "code cross-source graph links"
python3 - <<'PY'
import json, os, subprocess
url = os.environ["GBRAIN_DATABASE_URL"]
out = subprocess.check_output([
    "psql", url, "-Atc",
    "select source_id, slug from pages where deleted_at is null and type='code' order by source_id, slug;"
], text=True)
specs = []
for line in out.splitlines():
    source, slug = line.split("|", 1)
    if source == "gameflow-code-modeling-core":
        ctx = "Batch 1 modeling-core code page indexed by the code vectorization expansion plan."
    elif source == "gameflow-code-mlb-backtests":
        ctx = "Batch 2 MLB modeling/backtesting code page indexed by the code vectorization expansion plan."
    else:
        ctx = "MLB pilot code page indexed for GameFlow code retrieval parity."
    specs.append({
        "from": "operations/code-vectorization-expansion-plan",
        "fromSource": "gameflow",
        "to": slug,
        "toSource": source,
        "type": "indexes",
        "context": ctx,
    })
Path = __import__("pathlib").Path
Path("/tmp/gameflow-code-links.json").write_text(json.dumps(specs, indent=2))
print(f"wrote {len(specs)} cross-source link specs")
PY
run bun scripts/add_cross_source_links.ts --file /tmp/gameflow-code-links.json

section "schema hub link"
cd "$HOME/gbrain"
gbrain link brain-index schema --link-type mentions --context "Brain index links to the GameFlowBrain schema/resolver documentation." || true

section "timeline parity backfill for non-code pages"
psql "$GBRAIN_DATABASE_URL" -Atc "with missing as (select p.id, coalesce(p.effective_date::date, p.updated_at::date, p.created_at::date, current_date) as dt, coalesce(p.title, p.slug) as title from pages p where p.deleted_at is null and p.type <> 'code' and not exists (select 1 from timeline_entries t where t.page_id=p.id)) insert into timeline_entries (page_id, date, source, summary, detail) select id, dt, 'nightly sync/audit timeline backfill', 'Indexed page: ' || title, 'Added by deterministic nightly GameFlow GBrain maintenance for non-code pages without timeline entries.' from missing returning id;" | wc -l

section "extract markdown links/timeline"
gbrain extract all || true

section "final stats"
gbrain stats

section "final orphans"
ORPHANS_JSON="$(gbrain orphans --json)"
echo "$ORPHANS_JSON"
ORPHAN_COUNT="$(printf '%s' "$ORPHANS_JSON" | python3 -c 'import json,sys; s=sys.stdin.read(); i=s.find("{"); print(json.loads(s[i:])["total_orphans"])')"

section "doctor"
DOCTOR_JSON="$(gbrain doctor --json || true)"
echo "$DOCTOR_JSON" > "$LOG_FILE.doctor.json"
DOCTOR_JSON_PATH="$LOG_FILE.doctor.json" python3 - <<'PY' || true
import json, os
path = os.environ["DOCTOR_JSON_PATH"]
s = open(path, encoding="utf-8").read()
i = s.find('{')
if i < 0:
    print('doctor json not found')
    raise SystemExit(0)
d = json.loads(s[i:])
print({"status": d.get("status"), "health_score": d.get("health_score")})
for c in d.get("checks", []):
    if c.get("status") in {"fail", "warn"}:
        print(f"{c.get('status').upper()}: {c.get('name')}: {c.get('message')}")
PY

section "summary"
if [[ "$ORPHAN_COUNT" != "0" ]]; then
  echo "FAIL: orphan count is $ORPHAN_COUNT"
  echo "log: $LOG_FILE"
  exit 2
fi
MISSING_EMBEDS="$(psql "$GBRAIN_DATABASE_URL" -Atc "select count(*) from content_chunks where embedding is null;")"
if [[ "$MISSING_EMBEDS" != "0" ]]; then
  echo "FAIL: missing embeddings = $MISSING_EMBEDS"
  echo "log: $LOG_FILE"
  exit 3
fi
echo "PASS: deterministic GameFlow GBrain sync/audit completed"
echo "log: $LOG_FILE"
