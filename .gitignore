data/

# Also ignore any rogue CSVs or DBs in the source code
*.csv
*.db
*.sqlite
*.sqlite3

# If you have specific large JSON dumps, ignore them too
*.json
!package.json  # (Exception: if you use JS, don't ignore package.json)
!.mcp.json     # (Exception: if you want to track your tool config)

# --- IDE Settings ---
.vscode/
.idea/

# --- Logs & OS Junk ---
*.log
.DS_Store
Thumbs.db